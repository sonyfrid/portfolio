<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_prepayment" targetNamespace="https://example.org/bpmn">
  <bpmn:collaboration id="collab">
    <bpmn:participant id="part" name="Договор и предоплата" processRef="prepayment"/>
  </bpmn:collaboration>
  <bpmn:process id="prepayment" name="Договор и предоплата" isExecutable="false">
    <bpmn:documentation>Уведомлению об оплате сервис не доверяет: статус, сумма и сделка перечитываются из API ЮKassa. Повторное уведомление не меняет данные, стадия сделки не откатывается назад.</bpmn:documentation>
    <bpmn:laneSet id="ls">
      <bpmn:lane id="lane0" name="Менеджер"><bpmn:flowNodeRef>s</bpmn:flowNodeRef><bpmn:flowNodeRef>m1</bpmn:flowNodeRef><bpmn:flowNodeRef>m2</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="lane1" name="Клиент"><bpmn:flowNodeRef>c1</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="lane2" name="Сервис оплаты"><bpmn:flowNodeRef>a1</bpmn:flowNodeRef><bpmn:flowNodeRef>g0</bpmn:flowNodeRef><bpmn:flowNodeRef>e0</bpmn:flowNodeRef><bpmn:flowNodeRef>a2</bpmn:flowNodeRef><bpmn:flowNodeRef>a3</bpmn:flowNodeRef><bpmn:flowNodeRef>g3</bpmn:flowNodeRef><bpmn:flowNodeRef>a8</bpmn:flowNodeRef><bpmn:flowNodeRef>e3</bpmn:flowNodeRef><bpmn:flowNodeRef>g1</bpmn:flowNodeRef><bpmn:flowNodeRef>a4</bpmn:flowNodeRef><bpmn:flowNodeRef>e1</bpmn:flowNodeRef><bpmn:flowNodeRef>g2</bpmn:flowNodeRef><bpmn:flowNodeRef>e2</bpmn:flowNodeRef><bpmn:flowNodeRef>a5</bpmn:flowNodeRef><bpmn:flowNodeRef>a7</bpmn:flowNodeRef><bpmn:flowNodeRef>g4</bpmn:flowNodeRef><bpmn:flowNodeRef>a6</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="lane3" name="ЮKassa"><bpmn:flowNodeRef>y1</bpmn:flowNodeRef><bpmn:flowNodeRef>y2</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="lane4" name="Битрикс24"><bpmn:flowNodeRef>b1</bpmn:flowNodeRef><bpmn:flowNodeRef>b2</bpmn:flowNodeRef><bpmn:flowNodeRef>e</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Договор подписан"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="m1" name="Запросить ссылку на предоплату"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="a1" name="Проверить воронку и сумму, рассчитать предоплату 30%"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g0" name="Сумма указана?"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing><bpmn:outgoing>f5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="e0" name="Ошибка менеджеру"><bpmn:incoming>f5</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="a2" name="Создать платёж с ключом идемпотентности"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="y1" name="Создать платёж и ссылку"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="b1" name="Ссылка на оплату в ленте сделки"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="m2" name="Отправить ссылку клиенту"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:userTask>
    <bpmn:manualTask id="c1" name="Оплатить по ссылке"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:manualTask>
    <bpmn:serviceTask id="y2" name="Отправить уведомление об оплате"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="a3" name="Перечитать платёж через API ЮKassa"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g3" name="API ответил?"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing><bpmn:outgoing>f14</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="a8" name="Ответить 503: ЮKassa повторит уведомление"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="e3" name="Ждём повтор"><bpmn:incoming>f15</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="g1" name="Статус, сумма и сделка верны?"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing><bpmn:outgoing>f17</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="a4" name="Записать событие в журнал"><bpmn:incoming>f17</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="e1" name="Стадия не меняется"><bpmn:incoming>f18</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="g2" name="Первое уведомление?"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing><bpmn:outgoing>f20</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="e2" name="Повтор: без изменений"><bpmn:incoming>f20</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="a5" name="Записать оплату в журнал"><bpmn:incoming>f19</bpmn:incoming><bpmn:outgoing>f21</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="a7" name="Передать оплату в CRM"><bpmn:incoming>f21</bpmn:incoming><bpmn:incoming>f26</bpmn:incoming><bpmn:outgoing>f22</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g4" name="CRM ответила?"><bpmn:incoming>f22</bpmn:incoming><bpmn:outgoing>f23</bpmn:outgoing><bpmn:outgoing>f24</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="a6" name="Повторить через 5 минут"><bpmn:incoming>f24</bpmn:incoming><bpmn:outgoing>f26</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="b2" name="Комментарий; стадия «Предоплата получена», если сделка не дальше"><bpmn:incoming>f23</bpmn:incoming><bpmn:outgoing>f25</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="e" name="Предоплата учтена"><bpmn:incoming>f25</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" name="" sourceRef="s" targetRef="m1"/>
    <bpmn:sequenceFlow id="f2" name="" sourceRef="m1" targetRef="a1"/>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_estimate_approval" targetNamespace="https://example.org/bpmn">
  <bpmn:collaboration id="collab">
    <bpmn:participant id="part" name="Согласование сметы" processRef="estimate_approval"/>
  </bpmn:collaboration>
  <bpmn:process id="estimate_approval" name="Согласование сметы" isExecutable="false">
    <bpmn:documentation>Настроено штатно: робот ставит задачу, триггер по завершению задачи переводит сделку на стадию Договор. Условие по названию задачи защищает от срабатывания на посторонних задачах.</bpmn:documentation>
    <bpmn:laneSet id="ls">
      <bpmn:lane id="lane0" name="Клиент"><bpmn:flowNodeRef>c1</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="lane1" name="Менеджер"><bpmn:flowNodeRef>m1</bpmn:flowNodeRef><bpmn:flowNodeRef>g1</bpmn:flowNodeRef><bpmn:flowNodeRef>m2</bpmn:flowNodeRef><bpmn:flowNodeRef>m3</bpmn:flowNodeRef><bpmn:flowNodeRef>m4</bpmn:flowNodeRef><bpmn:flowNodeRef>e3</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="lane2" name="Битрикс24"><bpmn:flowNodeRef>s</bpmn:flowNodeRef><bpmn:flowNodeRef>b1</bpmn:flowNodeRef><bpmn:flowNodeRef>b2</bpmn:flowNodeRef><bpmn:flowNodeRef>g2</bpmn:flowNodeRef><bpmn:flowNodeRef>b3</bpmn:flowNodeRef><bpmn:flowNodeRef>e1</bpmn:flowNodeRef><bpmn:flowNodeRef>e2</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Сделка вошла на «Смету на согласовании»"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="b1" name="Робот: задача «Согласовать смету с клиентом», срок 3 дня"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="m1" name="Отправить смету клиенту"><bpmn:incoming>f2</bpmn:incoming><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:userTask>
    <bpmn:manualTask id="c1" name="Рассмотреть смету"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="g1" name="Ответ клиента"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing><bpmn:outgoing>f6</bpmn:outgoing><bpmn:outgoing>f8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="m2" name="Обновить смету и сумму в сделке"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="m3" name="Завершить задачу согласования"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="m4" name="Стадия «Отказ», причина. Задачу не завершать как согласованную"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="e3" name="Отказ"><bpmn:incoming>f9</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="b2" name="Триггер «Смета согласована»: задача по сделке завершена"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g2" name="Это задача согласования?"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing><bpmn:outgoing>f13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="b3" name="Сделка переходит на стадию «Договор»"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="e1" name="Смета согласована"><bpmn:incoming>f14</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="e2" name="Стадия не меняется"><bpmn:incoming>f13</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" name="" sourceRef="s" targetRef="b1"/>
    <bpmn:sequenceFlow id="f2" name="" sourceRef="b1" targetRef="m1"/>
    <bpmn:sequenceFlow id="f3" name="" sourceRef="m1" targetRef="c1"/>
    <bpmn:sequenceFlow id="f4" name="" sourceRef="c1" targetRef="g1"/>
    <bpmn:sequenceFlow id="f5" name="Согласовал" sourceRef="g1" targetRef="m3"/>
    <bpmn:sequenceFlow id="f6" name="Правки" sourceRef="g1" targetRef="m2"/>
    <bpmn:sequenceFlow id="f7" name="" sourceRef="m2" targetRef="m1"/>
    <bpmn:sequenceFlow id="f8" name="Отказ" sourceRef="g1" targetRef="m4"/>
    <bpmn:sequenceFlow id="f9" name="" sourceRef="m4" targetRef="e3"/>
    <bpmn:sequenceFlow id="f10" name="" sourceRef="m3" targetRef="b2"/>
    <bpmn:sequenceFlow id="f11" name="" sourceRef="b2" targetRef="g2"/>
    <bpmn:sequenceFlow id="f12" name="Да" sourceRef="g2" targetRef="b3"/>
    <bpmn:sequenceFlow id="f13" name="Нет" sourceRef="g2" targetRef="e2"/>
    <bpmn:sequenceFlow id="f14" name="" sourceRef="b3" targetRef="e1"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="dia">
    <bpmndi:BPMNPlane id="plane" bpmnElement="collab">
      <bpmndi:BPMNShape id="part_di" bpmnElement="part" isHorizontal="true"><dc:Bounds x="30" y="30" width="1436" height="620"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane0_di" bpmnElement="lane0" isHorizontal="true"><dc:Bounds x="60" y="30" width="1406" height="124"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane1_di" bpmnElement="lane1" isHorizontal="true"><dc:Bounds x="60" y="154" width="1406" height="248"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane2_di" bpmnElement="lane2" isHorizontal="true"><dc:Bounds x="60" y="402" width="1406" height="248"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_di" bpmnElement="s"><dc:Bounds x="142" y="446" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="100" y="484" width="120" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="b1_di" bpmnElement="b1"><dc:Bounds x="262" y="418" width="140" height="92"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m1_di" bpmnElement="m1"><dc:Bounds x="262" y="170" width="140" height="92"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c1_di" bpmnElement="c1"><dc:Bounds x="434" y="46" width="140" height="92"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true"><dc:Bounds x="651" y="191" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="559" y="225" width="100" height="16"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m2_di" bpmnElement="m2"><dc:Bounds x="606" y="294" width="140" height="92"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m3_di" bpmnElement="m3"><dc:Bounds x="778" y="170" width="140" height="92"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m4_di" bpmnElement="m4"><dc:Bounds x="950" y="170" width="140" height="92"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e3_di" bpmnElement="e3"><dc:Bounds x="1174" y="198" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1132" y="236" width="120" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="b2_di" bpmnElement="b2"><dc:Bounds x="778" y="418" width="140" height="92"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g2_di" bpmnElement="g2" isMarkerVisible="true"><dc:Bounds x="995" y="439" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="935" y="409" width="170" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="b3_di" bpmnElement="b3"><dc:Bounds x="1122" y="418" width="140" height="92"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e1_di" bpmnElement="e1"><dc:Bounds x="1346" y="446" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1304" y="484" width="120" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e2_di" bpmnElement="e2"><dc:Bounds x="1002" y="570" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="960" y="608" width="120" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="178" y="464"/><di:waypoint x="262" y="464"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="332" y="418"/><di:waypoint x="332" y="262"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="402" y="216"/><di:waypoint x="420" y="216"/><di:waypoint x="420" y="92"/><di:waypoint x="434" y="92"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="574" y="92"/><di:waypoint x="637" y="92"/><di:waypoint x="637" y="216"/><di:waypoint x="651" y="216"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="701" y="216"/><di:waypoint x="778" y="216"/><bpmndi:BPMNLabel><dc:Bounds x="704" y="199" width="68" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="676" y="241"/><di:waypoint x="676" y="294"/><bpmndi:BPMNLabel><dc:Bounds x="682" y="245" width="68" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7"><di:waypoint x="606" y="340"/><di:waypoint x="362" y="340"/><di:waypoint x="362" y="262"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8"><di:waypoint x="676" y="191"/><di:waypoint x="676" y="162"/><di:waypoint x="1020" y="162"/><di:waypoint x="1020" y="170"/><bpmndi:BPMNLabel><dc:Bounds x="682" y="175" width="68" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f9_di" bpmnElement="f9"><di:waypoint x="1090" y="216"/><di:waypoint x="1174" y="216"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f10_di" bpmnElement="f10"><di:waypoint x="848" y="262"/><di:waypoint x="848" y="418"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f11_di" bpmnElement="f11"><di:waypoint x="918" y="464"/><di:waypoint x="995" y="464"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f12_di" bpmnElement="f12"><di:waypoint x="1045" y="464"/><di:waypoint x="1122" y="464"/><bpmndi:BPMNLabel><dc:Bounds x="1048" y="447" width="68" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f13_di" bpmnElement="f13"><di:waypoint x="1020" y="489"/><di:waypoint x="1020" y="570"/><bpmndi:BPMNLabel><dc:Bounds x="1026" y="493" width="68" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f14_di" bpmnElement="f14"><di:waypoint x="1262" y="464"/><di:waypoint x="1346" y="464"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
